{
  "name": "gh-dashboard",
  "private": true,
  "type": "module",
  "description": "gh.bioinfolder.com: one inbox for the lab's GitHub PRs, with iPhone/Mac push",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --import tsx --test tests/acceptance/*.test.ts tests/adapter/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "live-check": "GH_TOKEN=$(gh auth token) node scripts/live-check.ts jeonglab-bcm hyunhwan-bcm"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/web-push": "3.6.4",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "octokit": "5.0.5",
    "web-push": "3.6.7",
    "yaml": "2.9.1"
  }
}
