# Copy to .env (gitignored, chmod 600). Never commit real values.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
# 32 random bytes, base64:   openssl rand -base64 32
TOKEN_KEY=
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hyun-hwan.jeong@bcm.edu
# Optional, SPEC 12/20: the key for config.yaml's llm.provider (OpenAI, Anthropic, or an
# OpenAI-compatible server; for the lab LLM a bif_ token from portal.bioinfolder.com/tokens).
# An admin can also choose the provider and key in Settings → AI instead.
LLM_API_KEY=
