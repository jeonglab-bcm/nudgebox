# Copy to .env (gitignored, chmod 600). Never commit real values.
# The GitHub App Nudgebox reads PRs and acts through (scripts/create-github-app.ts makes one)
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
# 32 random bytes, base64:   openssl rand -base64 32
TOKEN_KEY=
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# a contact for push services, e.g. mailto:you@example.org
VAPID_SUBJECT=
# Optional, SPEC 12/20: the key for config.yaml's llm.provider (OpenAI, Anthropic, or an
# OpenAI-compatible server that needs one). An admin can also choose the provider and key
# in Settings → AI instead.
LLM_API_KEY=

# deploy/docker-compose.yml only: sign-in with GitHub through oauth2-proxy. A separate
# GitHub OAuth App (Settings → Developer settings → OAuth Apps) with the callback
# https://<your site>/oauth2/callback
SIGNIN_GITHUB_ORG=
SIGNIN_CLIENT_ID=
SIGNIN_CLIENT_SECRET=
# openssl rand -base64 32 | tr -- '+/' '-_'
SIGNIN_COOKIE_SECRET=
SIGNIN_REDIRECT_URL=https://review.example.org/oauth2/callback
