{
  "name": "Nudgebox",
  "short_name": "Nudgebox",
  "description": "The Jeong Lab's GitHub inbox: PRs and issues, needs-you first, with nudges",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fcfcfc",
  "theme_color": "#fcfcfc",
  "icons": [
    {
      "src": "/icon-180.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
